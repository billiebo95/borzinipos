<?xml version="1.0" encoding="utf-8"?>
<!-- Stylised recreation of the BORZINI badge (rounded pill outline, sunrise + coffee bean,
     rolling hills below) supplied as a reference image - redrawn as vector paths since the
     original raster file was not reachable from this environment's filesystem. Content is kept
     inside roughly the inner 66dp "safe zone" of the 108dp adaptive-icon canvas so a circular or
     squircle launcher mask does not clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="26" android:translateY="16">

        <!-- Pill / badge outline -->
        <path
            android:pathData="M 2,28 A 26,26 0 1 1 54,28 L 54,48 A 26,26 0 1 1 2,48 Z"
            android:strokeColor="#4A1420"
            android:strokeWidth="3.4"
            android:fillColor="#00000000" />

        <!-- Sunburst rays -->
        <path
            android:pathData="M38,17 L45,17 M36.7,12.0 L42.7,8.5 M33,8.3 L36.5,2.3 M28,7 L28,0 M23,8.3 L19.5,2.3 M19.3,12.0 L13.3,8.5 M18,17 L11,17"
            android:strokeColor="#C9932E"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Coffee bean -->
        <path
            android:pathData="M 28,7 A 6,10 0 1 1 28,27 A 6,10 0 1 1 28,7 Z"
            android:strokeColor="#C9932E"
            android:strokeWidth="2"
            android:fillColor="#00000000" />
        <path
            android:pathData="M 28,9 C 25,12 31,15 28,17 C 25,19 31,22 28,25"
            android:strokeColor="#C9932E"
            android:strokeWidth="1.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Rolling hills -->
        <path
            android:pathData="M5,56 C15,50 25,62 35,54 C40,50 46,58 51,54"
            android:strokeColor="#4A1420"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M5,62 C15,56 25,68 35,60 C40,56 46,64 51,60"
            android:strokeColor="#4A1420"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M5,68 C15,62 25,74 35,66 C40,62 46,70 51,66"
            android:strokeColor="#4A1420"
            android:strokeWidth="2"
            android:strokeLineCap="round"
